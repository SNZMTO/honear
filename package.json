{
  "name": "honear",
  "version": "0.1.0",
  "description": "Honear, le blind test entre potes : un écran pour la tablée, un téléphone chacun.",
  "private": true,
  "type": "module",
  "scripts": {
    "planche": "tsx src/planche/etape1.ts",
    "controle": "tsx outils/controler.ts",
    "types": "tsc --noEmit && tsc --noEmit -p tsconfig.page.json",
    "test": "npm run types && tsx --test tests/*.test.ts",
    "polices": "python3 outils/preparer-polices.py",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"outils/**/*.ts\"",
    "atelier": "tsx src/planche/etape2.ts",
    "systeme": "tsx src/planche/etape3.ts",
    "pochette": "tsx src/planche/etape4.ts",
    "ecrans": "tsx src/planche/etape5.ts",
    "hote": "tsx src/planche/etape6.ts",
    "animations": "tsx src/planche/etape7.ts",
    "prototype": "tsx src/planche/prototype.ts",
    "vitrine": "tsx src/planche/vitrine.ts",
    "construire": "tsx outils/construire.ts",
    "site": "node dist/serveur.mjs"
  },
  "dependencies": {
    "opentype.js": "^2.0.0",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/caprasimo": "^5.3.0",
    "@types/node": "^26.6.4",
    "@types/opentype.js": "^1.3.10",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
