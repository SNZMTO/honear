# Le relais devant le jeu, dans son conteneur : le HTTPS (Caddy prend et renouvelle seul les certificats Let's Encrypt), la page
# compressée, les WebSockets qui passent tels quels, et les en-têtes de sécurité que le jeu ne pose pas lui-même. Le jeu répond
# sur le réseau des conteneurs, à l'adresse « jeu:8080 ».
#
# DOMAINE est l'adresse du jeu ; ANCIEN_DOMAINE renvoie vers elle (deploiement/compose.yaml les lui donne, depuis
# /etc/miel-doreilles/site.env).

{
	# Les journaux de Caddy ne disent que ses erreurs : aucune visite n'y est écrite (voir la page « Confidentialité »).
	log {
		level ERROR
	}
}

(securite) {
	header {
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		X-Frame-Options "DENY"
		-Server
	}
}

{$DOMAINE} {
	import securite
	encode zstd gzip
	reverse_proxy jeu:8080
}

www.{$DOMAINE} {
	import securite
	redir https://{$DOMAINE}{uri} permanent
}

# L'ancienne adresse : tout y mène au jeu, à sa nouvelle adresse (un lien de room, un lien de connexion, son ancre comprise).
# Temporaire (302) : ce domaine accueillera un autre site.
{$ANCIEN_DOMAINE}, www.{$ANCIEN_DOMAINE} {
	import securite
	redir https://{$DOMAINE}{uri} 302
}
